<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <PlatformTarget>x64</PlatformTarget>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <!-- The .NET 10 SDK marks the launcher exe as CET shadow stack compatible. MO2's usvfs hooks break that: the exe crashes at
         start (0xC0000005 in an unknown module) when started from MO2's executables list. Off, it starts in MO2 like any other tool. -->
    <CETCompat>false</CETCompat>
    <!-- One version for the tool and the SKSE plugin: the VERSION file at the repo root (bump.ps1 raises the last number). -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim())</Version>
    <!-- Only the languages that ship: English (neutral) and Simplified Chinese, so no other culture folders appear next to the exe. -->
    <SatelliteResourceLanguages>en;zh-CN</SatelliteResourceLanguages>
    <Authors>CageTV</Authors>
    <Product>AnvilLOD</Product>
    <!-- Normalizes the source paths baked into the .pdb files and the .dll debug directory to "/_/..." instead of the
         absolute path of whatever machine built the release (which included the builder's folder names). -->
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
