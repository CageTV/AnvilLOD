<Window x:Class="AnvilLOD.App.RuleEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AnvilLOD.App.Localization"
        Title="{loc:Loc Dialog_Title}" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="18,14,18,16">
        <TextBlock Text="{loc:Loc Dialog_MaskLabel}" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
        <TextBox x:Name="MaskBox" ToolTip="{loc:Loc Tip_DialogMask}" />
        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                   Text="{loc:Loc Dialog_MaskHelp}" />

        <TextBlock Text="{loc:Loc Dialog_SectionFlags}" Style="{StaticResource SectionHeader}" />
        <CheckBox x:Name="VwdCheck" Content="{loc:Loc Dialog_FlagVwd}" />
        <CheckBox x:Name="NoGlowCheck" Content="{loc:Loc Dialog_FlagNoGlow}" />
        <CheckBox x:Name="NoMatoCheck" Content="{loc:Loc Dialog_FlagNoMato}" />
        <CheckBox x:Name="DynamicCheck" Content="{loc:Loc Dialog_FlagDynamic}" />
        <CheckBox x:Name="TreeCheck" Content="{loc:Loc Dialog_FlagTree}" />

        <TextBlock Text="{loc:Loc Dialog_SectionStatic}" Style="{StaticResource SectionHeader}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="22" />
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Dialog_Level4}" VerticalAlignment="Center" Margin="0,0,10,8" />
            <ComboBox x:Name="Lod4Box" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" />
            <TextBlock Grid.Row="0" Grid.Column="3" Text="{loc:Loc Dialog_Level8}" VerticalAlignment="Center" Margin="0,0,10,8" />
            <ComboBox x:Name="Lod8Box" Grid.Row="0" Grid.Column="4" Margin="0,0,0,8" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Dialog_Level16}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox x:Name="Lod16Box" Grid.Row="1" Grid.Column="1" />
            <TextBlock Grid.Row="1" Grid.Column="3" Text="{loc:Loc Dialog_Level32}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox x:Name="Lod32Box" Grid.Row="1" Grid.Column="4" />
        </Grid>
        <TextBlock Margin="0,6,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                   Text="{loc:Loc Dialog_LevelHelp}" />

        <TextBlock Text="{loc:Loc Dialog_SectionDynamic}" Style="{StaticResource SectionHeader}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="22" />
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{loc:Loc Header_Grid}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox x:Name="GridBox" Grid.Column="1" />
            <TextBlock Grid.Column="3" Text="{loc:Loc Header_Reference}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox x:Name="ReferenceBox" Grid.Column="4"
                      ToolTip="{loc:Loc Tip_DialogReference}" />
        </Grid>
        <TextBlock Margin="0,6,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                   Text="{loc:Loc Dialog_GridHelp}" />

        <TextBlock Text="{loc:Loc Dialog_Description}" Style="{StaticResource FieldLabel}" Margin="0,12,0,3" />
        <TextBox x:Name="DescriptionBox" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:Loc Btn_Ok}" Style="{StaticResource PrimaryButton}" Width="90" Margin="0,0,8,0" Click="Ok_Click" IsDefault="True" />
            <Button Content="{loc:Loc Btn_Cancel}" Width="90" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
