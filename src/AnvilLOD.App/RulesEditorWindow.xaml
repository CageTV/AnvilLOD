<Window x:Class="AnvilLOD.App.RulesEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AnvilLOD.App.Localization"
        Title="{loc:Loc Rules_WindowTitle}" Width="1060" Height="660" MinWidth="820" MinHeight="420"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Closing="Window_Closing">
    <DockPanel Margin="16,14,16,14">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" />
            <TextBlock x:Name="InfoText" Margin="0,4,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
            <DockPanel Margin="0,4,0,10">
                <TextBox x:Name="FilterBox" DockPanel.Dock="Right" Width="240" Margin="12,0,0,0" TextChanged="FilterBox_TextChanged"
                         ToolTip="{loc:Loc Tip_EditorFilter}" />
                <TextBlock DockPanel.Dock="Right" Text="{loc:Loc Editor_Find}" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                <TextBlock x:Name="FileText" VerticalAlignment="Center" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{loc:Loc Btn_LoadFile}" Margin="0,0,8,0" Padding="12,5" Click="Load_Click"
                        ToolTip="{loc:Loc Tip_LoadFile}" />
                <Button Content="{loc:Loc Btn_SaveAs}" Margin="0,0,8,0" Padding="12,5" Click="SaveAs_Click" />
                <Button Content="{loc:Loc Btn_Save}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Padding="16,5" Click="Save_Click"
                        ToolTip="{loc:Loc Tip_Save}" />
                <Button Content="{loc:Loc Btn_Close}" Padding="14,5" Click="Close_Click" />
            </StackPanel>
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
        </DockPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="{loc:Loc Btn_AddRule}" Margin="0,0,8,0" Padding="12,5" Click="Add_Click" />
            <Button x:Name="EditButton" Content="{loc:Loc Btn_EditRule}" Margin="0,0,8,0" Padding="12,5" Click="Edit_Click"
                    ToolTip="{loc:Loc Tip_EditRule}" />
            <Button x:Name="RemoveButton" Content="{loc:Loc Btn_RemoveRule}" Margin="0,0,8,0" Padding="12,5" Click="Remove_Click"
                    ToolTip="{loc:Loc Tip_RemoveRule}" />
            <Button x:Name="UpButton" Content="▲" Width="34" Margin="0,0,4,0" Click="Up_Click" ToolTip="{loc:Loc Tip_Up}" />
            <Button x:Name="DownButton" Content="▼" Width="34" Margin="0,0,16,0" Click="Down_Click" ToolTip="{loc:Loc Tip_Down}" />
            <Button Content="{loc:Loc Btn_ResetRules}" Padding="12,5" Click="Reset_Click" />
        </StackPanel>

        <DataGrid x:Name="RuleGrid" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  SelectionChanged="RuleGrid_SelectionChanged" MouseDoubleClick="RuleGrid_DoubleClick">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCustom}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Loc Header_Mask}" Binding="{Binding Mask}" Width="2*" />
                <DataGridTextColumn Header="LOD 4" Binding="{Binding Lod4}" Width="88" />
                <DataGridTextColumn Header="LOD 8" Binding="{Binding Lod8}" Width="88" />
                <DataGridTextColumn Header="LOD 16" Binding="{Binding Lod16}" Width="88" />
                <DataGridTextColumn Header="LOD 32" Binding="{Binding Lod32}" Width="88" />
                <DataGridTextColumn Header="{loc:Loc Header_Flags}" Binding="{Binding FlagsText}" Width="120" />
                <DataGridTextColumn Header="{loc:Loc Header_Grid}" Binding="{Binding Grid}" Width="84" />
                <DataGridTextColumn Header="{loc:Loc Header_Reference}" Binding="{Binding Reference}" Width="92" />
                <DataGridTextColumn Header="{loc:Loc Header_From}" Binding="{Binding Source}" Width="1.4*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
