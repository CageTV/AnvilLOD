<Window x:Class="AnvilLOD.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AnvilLOD.App.Localization"
        Title="AnvilLOD" Icon="pack://application:,,,/anvillod.ico" Width="1280" Height="900" MinWidth="980" MinHeight="640"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <DockPanel>

        <!-- ===== Header: logo, status and the game source ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="18,10,18,10">
            <StackPanel>
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/anvillod-256.png" Width="34" Height="34" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Anvil" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Text="LOD" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                        <TextBlock x:Name="VersionText" Text="v0.1" Foreground="{StaticResource Muted}" FontSize="11" Margin="8,0,0,2" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" Text="{loc:Loc Status_Ready}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Loc Language_Label}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="24,0,6,0" />
                        <ComboBox x:Name="LanguageBox" Width="150" Height="24" FontSize="12" SelectionChanged="Language_Changed" />
                    </StackPanel>
                </DockPanel>

                <Border Margin="0,10,0,0" Background="{StaticResource Bg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="14,8,14,10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Margin="0,0,26,0">
                            <TextBlock Text="{loc:Loc Section_Game}" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="Mo2Radio" Content="{loc:Loc Source_Mo2}" GroupName="Source" Margin="0,0,18,0" Checked="SourceMode_Changed" />
                                <RadioButton x:Name="VortexRadio" Content="Vortex" GroupName="Source" Margin="0,0,18,0" Checked="SourceMode_Changed" />
                                <RadioButton x:Name="DataRadio" Content="{loc:Loc Source_DataFolder}" GroupName="Source" Checked="SourceMode_Changed" />
                            </StackPanel>
                        </StackPanel>

                        <Grid>
                            <StackPanel x:Name="Mo2Panel">
                                <WrapPanel>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="{loc:Loc Mo2_InstanceFolder}" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                                        <DockPanel Width="340">
                                            <Button DockPanel.Dock="Right" Content="…" Width="32" Padding="0,4" Margin="6,0,0,0" Click="BrowseMo2_Click" />
                                            <TextBox x:Name="Mo2Box" ToolTip="{loc:Loc Tip_Mo2Box}" LostFocus="Mo2Box_LostFocus" />
                                        </DockPanel>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="{loc:Loc Mo2_Profile}" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                                        <ComboBox x:Name="ProfileBox" Width="200" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text=" " Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                                        <Button x:Name="Mo2LocationsButton" Content="{loc:Loc Locations_Button}" Padding="12,4" Click="Mo2Locations_Click"
                                                ToolTip="{loc:Loc Tip_Locations}" />
                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock x:Name="Mo2InfoText" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"
                                           Text="{loc:Loc Mo2_InfoDefault}" />
                                <Popup x:Name="Mo2LocationsPopup" PlacementTarget="{Binding ElementName=Mo2LocationsButton}" Placement="Bottom" StaysOpen="False"
                                       AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="4">
                                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="8" Padding="14,10,14,14" Width="400" Margin="10">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.6" />
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc Locations_Section}" Style="{StaticResource SectionHeader}" Margin="0,0,0,2" />
                                            <TextBlock Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"
                                                       Text="{loc:Loc Locations_PopupHint}" />
                                            <TextBlock Text="{loc:Loc Locations_GameFolder}" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="Mo2GameBox" ToolTip="{loc:Loc Tip_Mo2GameBox}" LostFocus="Mo2Box_LostFocus" />
                                            <TextBlock Text="{loc:Loc Locations_ModsFolder}" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="Mo2ModsBox" ToolTip="{loc:Loc Tip_Mo2ModsBox}" LostFocus="Mo2Box_LostFocus" />
                                            <TextBlock Text="{loc:Loc Locations_ProfilesFolder}" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="Mo2ProfilesBox" ToolTip="{loc:Loc Tip_Mo2ProfilesBox}" LostFocus="Mo2Box_LostFocus" />
                                            <TextBlock Text="{loc:Loc Locations_OverwriteFolder}" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="Mo2OverwriteBox" ToolTip="{loc:Loc Tip_Mo2OverwriteBox}" LostFocus="Mo2Box_LostFocus" />
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </StackPanel>

                            <StackPanel x:Name="DataPanel" Visibility="Collapsed">
                                <WrapPanel>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="{loc:Loc Source_DataFolder}" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                                        <DockPanel Width="340">
                                            <Button DockPanel.Dock="Right" Content="…" Width="32" Padding="0,4" Margin="6,0,0,0" Click="BrowseData_Click" />
                                            <TextBox x:Name="DataBox" ToolTip="{loc:Loc Tip_DataBox}" />
                                        </DockPanel>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc Data_PluginsTxt}" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                                        <DockPanel Width="340">
                                            <Button DockPanel.Dock="Right" Content="…" Width="32" Padding="0,4" Margin="6,0,0,0" Click="BrowsePlugins_Click" />
                                            <TextBox x:Name="PluginsBox" ToolTip="{loc:Loc Tip_PluginsBox}" />
                                        </DockPanel>
                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock x:Name="DataInfoText" Text="{loc:Loc Data_InfoPlain}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                                <StackPanel x:Name="VortexPanel" Visibility="Collapsed" Margin="0,6,0,0">
                                    <Button x:Name="VortexOutputButton" Content="{loc:Loc Vortex_OutputToStaging}" Padding="8,4" HorizontalAlignment="Left" Click="VortexOutput_Click" />
                                    <TextBlock x:Name="VortexInfoText" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ===== Footer: progress + actions ===== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="18,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ExportButton" Content="{loc:Loc Btn_Export}" Margin="0,0,8,0" IsEnabled="False" Click="Export_Click" />
                    <Button x:Name="CancelButton" Content="{loc:Loc Btn_Cancel}" Margin="0,0,8,0" IsEnabled="False" Click="Cancel_Click" />
                    <Button x:Name="ScanButton" Content="{loc:Loc Btn_Scan}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="Scan_Click" />
                    <Button x:Name="GenerateButton" Content="{loc:Loc Btn_Generate}" Style="{StaticResource PrimaryButton}" Click="Generate_Click"
                            ToolTip="{loc:Loc Tip_Generate}" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <ProgressBar x:Name="Progress" IsIndeterminate="False" Value="0" />
                    <TextBlock x:Name="ProgressText" Text="{loc:Loc Status_Idle}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="EstimateText" Text="" Foreground="{StaticResource Accent}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Body ===== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumn" Width="224" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Categories: one button per group of settings, then the mod author tools -->
            <Border x:Name="NavBorder" Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0" ClipToBounds="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,14,12,14" Width="198">
                        <TextBlock Text="{loc:Loc Nav_Settings}" Style="{StaticResource SectionHeader}" Margin="8,0,0,8" />
                        <RadioButton x:Name="NavOutput" GroupName="Nav" Tag="Output" Style="{StaticResource NavButton}" Content="{loc:Loc Nav_Output}" IsChecked="True" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavRules" GroupName="Nav" Tag="Rules" Style="{StaticResource NavButton}" Content="{loc:Loc Nav_Rules}" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavObjects" GroupName="Nav" Tag="Objects" Style="{StaticResource NavButton}" Content="{loc:Loc Nav_Objects}" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavTrees" GroupName="Nav" Tag="Trees" Style="{StaticResource NavButton}" Content="{loc:Loc Nav_Trees}" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavGrass" GroupName="Nav" Tag="Grass" Style="{StaticResource NavButton}" Content="{loc:Loc Nav_Grass}" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavDynamic" GroupName="Nav" Tag="Dynamic" Style="{StaticResource NavButton}" Content="{loc:Loc Nav_Dynamic}" Checked="Nav_Checked" />
                        <TextBlock Text="{loc:Loc Nav_AuthorTools}" Style="{StaticResource SectionHeader}" Margin="8,22,0,8" />
                        <RadioButton x:Name="NavFinder" GroupName="Nav" Tag="Finder" Style="{StaticResource NavButton}" Content="{loc:Loc Nav_Finder}" Checked="Nav_Checked" ToolTip="{loc:Loc Tip_Nav_Finder}" />
                        <RadioButton x:Name="NavMaker" GroupName="Nav" Tag="Maker" Style="{StaticResource NavButton}" Content="{loc:Loc Nav_Maker}" Checked="Nav_Checked" ToolTip="{loc:Loc Tip_Nav_Maker}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right side: results above, the options of the chosen category below -->
            <Grid x:Name="RightGrid" Grid.Column="1" Margin="14,10,14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition x:Name="OptionsRow" Height="1.35*" />
                </Grid.RowDefinitions>

                <Border x:Name="ResultsBox" Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <Grid>
                        <!-- The emblem, barely visible behind everything in the results area (the tab control is transparent so it shows through). -->
                        <Image Source="pack://application:,,,/watermark.png" Margin="18,10,18,12" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.14" IsHitTestVisible="False"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TabControl x:Name="ResultsTabs" Margin="12,6,12,10" Background="Transparent">
<TabItem Header="{loc:Loc Tab_Overview}" Tag="Overview">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="OverviewHint" Text="{loc:Loc Overview_Hint}"
                                       Foreground="{StaticResource Muted}" Margin="0,6,0,14" TextWrapping="Wrap" />
                            <Border x:Name="WarningBox" Visibility="Collapsed" Background="#2E2418" BorderBrush="{StaticResource Accent}"
                                    BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,10,14">
                                <ItemsControl x:Name="WarningList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat='⚠  {0}'}" Foreground="#F2C08F" TextWrapping="Wrap" Margin="0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <WrapPanel x:Name="Tiles">
                                <Border Style="{StaticResource Tile}"><StackPanel><TextBlock x:Name="TilePlugins" Text="—" Style="{StaticResource TileValue}" /><TextBlock x:Name="TilePluginsLabel" Text="{loc:Loc Tile_Plugins}" Style="{StaticResource TileLabel}" /></StackPanel></Border>
                                <Border Style="{StaticResource Tile}"><StackPanel><TextBlock x:Name="TileVisited" Text="—" Style="{StaticResource TileValue}" /><TextBlock Text="{loc:Loc Tile_Visited}" Style="{StaticResource TileLabel}" /></StackPanel></Border>
                                <Border Style="{StaticResource Tile}"><StackPanel><TextBlock x:Name="TileLodRefs" Text="—" Style="{StaticResource TileValue}" /><TextBlock Text="{loc:Loc Tile_LodRefs}" Style="{StaticResource TileLabel}" /></StackPanel></Border>
                                <Border Style="{StaticResource Tile}"><StackPanel><TextBlock x:Name="TileBlocks" Text="—" Style="{StaticResource TileValue}" /><TextBlock Text="{loc:Loc Tile_Blocks}" Style="{StaticResource TileLabel}" /></StackPanel></Border>
                                <Border Style="{StaticResource Tile}"><StackPanel><TextBlock x:Name="TileRebuild" Text="—" Style="{StaticResource TileValue}" /><TextBlock x:Name="TileRebuildLabel" Text="{loc:Loc Tile_Rebuild}" Style="{StaticResource TileLabel}" /></StackPanel></Border>
                                <Border Style="{StaticResource Tile}"><StackPanel><TextBlock x:Name="TileMissing" Text="—" Style="{StaticResource TileValue}" /><TextBlock Text="{loc:Loc Tile_Missing}" Style="{StaticResource TileLabel}" /></StackPanel></Border>
                                <Border Style="{StaticResource Tile}"><StackPanel><TextBlock x:Name="TileTime" Text="—" Style="{StaticResource TileValue}" /><TextBlock Text="{loc:Loc Tile_Time}" Style="{StaticResource TileLabel}" /></StackPanel></Border>
                            </WrapPanel>

                            <TextBlock Text="{loc:Loc Section_BlocksPerLevel}" Style="{StaticResource SectionHeader}" />
                            <DataGrid x:Name="LevelGrid" Height="150" HorizontalAlignment="Left" Width="520">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc Header_Worldspace}" Binding="{Binding Worldspace}" Width="*" />
                                    <DataGridTextColumn Header="LOD 4" Binding="{Binding Lod4, StringFormat=N0}" Width="70" />
                                    <DataGridTextColumn Header="LOD 8" Binding="{Binding Lod8, StringFormat=N0}" Width="70" />
                                    <DataGridTextColumn Header="LOD 16" Binding="{Binding Lod16, StringFormat=N0}" Width="70" />
                                    <DataGridTextColumn Header="LOD 32" Binding="{Binding Lod32, StringFormat=N0}" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="{loc:Loc Section_Timing}" Style="{StaticResource SectionHeader}" />
                            <TextBlock x:Name="TimingText" Text="—" Foreground="{StaticResource Muted}" FontFamily="Consolas" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
<TabItem Header="{loc:Loc Tab_Blocks}" Tag="Blocks">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock x:Name="BlockCountText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <TextBox x:Name="BlockFilterBox" TextChanged="BlockFilter_Changed" ToolTip="{loc:Loc Tip_BlockFilter}" />
                        </DockPanel>
                        <DataGrid x:Name="BlockGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc Header_File}" Binding="{Binding File}" Width="*" />
                                <DataGridTextColumn Header="{loc:Loc Header_Level}" Binding="{Binding Level}" Width="60" />
                                <DataGridTextColumn Header="X" Binding="{Binding X}" Width="60" />
                                <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="60" />
                                <DataGridTextColumn Header="{loc:Loc Header_Refs}" Binding="{Binding Refs, StringFormat=N0}" Width="70" />
                                <DataGridTextColumn Header="{loc:Loc Header_Status}" Binding="{Binding Status}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
<TabItem Header="{loc:Loc Tab_Missing}" Tag="Missing">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                   Text="{loc:Loc Missing_Description}" />
                        <DataGrid x:Name="MissingGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc Header_MeshPath}" Binding="{Binding Path}" Width="2*" />
                                <DataGridTextColumn Header="{loc:Loc Header_Problem}" Binding="{Binding Problem}" Width="3*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
<TabItem Header="{loc:Loc Tab_Log}" Tag="Log">
                    <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             Background="#111317" Foreground="#C9D1C9" BorderThickness="1"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" VerticalContentAlignment="Top" />
                </TabItem>
                        </TabControl>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,14,0">
                            <Button x:Name="PrintButton" Content="{loc:Loc Btn_Print}" Padding="10,3" Margin="0,0,6,0" Click="PrintResults_Click"
                                    ToolTip="{loc:Loc Tip_Print}" />
                            <Button x:Name="ExpandButton" Content="{loc:Loc Btn_Expand}" Padding="10,3" Click="ExpandResults_Click"
                                    ToolTip="{loc:Loc Tip_Expand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="OptionsBox" Grid.Row="1" Margin="0,10,0,0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="OptionsTitle" Grid.Column="0" Text="{loc:Loc Nav_Output}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="18,10,12,0" />
                            <StackPanel Grid.Column="1" Width="372">
<Border x:Name="PresetBar" Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="12,10,12,0">
                        <Grid x:Name="PresetGrid" Height="38" SizeChanged="PresetGrid_SizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="PresetTab0" Grid.Column="0" GroupName="PresetTabs" Tag="0" Style="{StaticResource PresetTab}" Checked="PresetTab_Checked" MouseDoubleClick="PresetTab_DoubleClick" />
                            <RadioButton x:Name="PresetTab1" Grid.Column="1" GroupName="PresetTabs" Tag="1" Style="{StaticResource PresetTab}" Checked="PresetTab_Checked" MouseDoubleClick="PresetTab_DoubleClick" />
                            <RadioButton x:Name="PresetTab2" Grid.Column="2" GroupName="PresetTabs" Tag="2" Style="{StaticResource PresetTab}" Checked="PresetTab_Checked" MouseDoubleClick="PresetTab_DoubleClick" />
                            <TextBox x:Name="PresetRenameBox" Grid.Column="0" Visibility="Collapsed" Margin="3,4,3,5" Padding="6,2" VerticalContentAlignment="Center" MaxLength="18"
                                     KeyDown="PresetRename_KeyDown" LostFocus="PresetRename_LostFocus" />
                            <Border x:Name="PresetIndicator" Grid.ColumnSpan="3" Height="3" VerticalAlignment="Bottom" HorizontalAlignment="Left" CornerRadius="2"
                                    Background="{StaticResource Accent}" IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="PresetIndicatorMove" />
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect x:Name="PresetGlow" Color="#E0782E" BlurRadius="8" ShadowDepth="0" Opacity="0.7" />
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </Border>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,6,18,18" RenderTransformOrigin="0.5,0.5">
                            <ScrollViewer.RenderTransform>
                                <TranslateTransform x:Name="SettingsMove" />
                            </ScrollViewer.RenderTransform>
                            <StackPanel>
                                <StackPanel x:Name="SettingsPanel" MaxWidth="860" HorizontalAlignment="Left">
                        <StackPanel x:Name="CatOutput" Visibility="Visible">
                            <TextBlock Text="{loc:Loc CatOutput_Desc}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4" />
<TextBlock Text="{loc:Loc Section_Output}" Style="{StaticResource SectionHeader}" />
<TextBlock Text="{loc:Loc Output_Folder}" Style="{StaticResource FieldLabel}" />
<DockPanel>
                            <Button DockPanel.Dock="Right" Content="…" Width="32" Padding="0,4" Margin="6,0,0,0" Click="BrowseOutput_Click" />
                            <TextBox x:Name="OutputBox" ToolTip="{loc:Loc Tip_OutputBox}" />
                        </DockPanel>
<CheckBox x:Name="CleanOutputCheck" Content="{loc:Loc Opt_CleanOutput}" IsChecked="True" Margin="0,6,0,0"
                                  ToolTip="{loc:Loc Tip_CleanOutput}" />
<TextBlock Text="{loc:Loc Section_Worldspaces}" Style="{StaticResource SectionHeader}" />
<CheckBox x:Name="AllWorldspacesCheck" Content="{loc:Loc Opt_AllWorldspaces}" Checked="AllWorldspaces_Changed" Unchecked="AllWorldspaces_Changed" />
<TextBox x:Name="WorldspaceBox" Text="Tamriel" Margin="0,4,0,0" ToolTip="{loc:Loc Tip_WorldspaceBox}" />
<TextBlock Text="{loc:Loc Section_LodLevels}" Style="{StaticResource SectionHeader}" />
<WrapPanel>
                            <CheckBox x:Name="Lod4Check" Content="LOD 4" IsChecked="True" Margin="0,3,16,3" />
                            <CheckBox x:Name="Lod8Check" Content="LOD 8" IsChecked="True" Margin="0,3,16,3" />
                            <CheckBox x:Name="Lod16Check" Content="LOD 16" IsChecked="True" Margin="0,3,16,3" />
                            <CheckBox x:Name="Lod32Check" Content="LOD 32" IsChecked="True" Margin="0,3,16,3" />
                        </WrapPanel>
                        </StackPanel>
                        <StackPanel x:Name="CatRules" Visibility="Collapsed">
                            <TextBlock Text="{loc:Loc CatRules_Desc}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4" />
<TextBlock Text="{loc:Loc Section_LodRules}" Style="{StaticResource SectionHeader}" />
<TextBlock Text="{loc:Loc Rules_DynDolodFolder}" Style="{StaticResource FieldLabel}" />
<DockPanel>
                            <Button DockPanel.Dock="Right" Content="…" Width="32" Padding="0,4" Margin="6,0,0,0" Click="BrowseDynDolod_Click" />
                            <TextBox x:Name="DynDolodBox" ToolTip="{loc:Loc Tip_DynDolodBox}" />
                        </DockPanel>
<TextBlock Text="{loc:Loc Rules_Preset}" Style="{StaticResource FieldLabel}" />
<DockPanel>
                            <Button x:Name="EditRulesButton" DockPanel.Dock="Right" Content="{loc:Loc Btn_EditRules}" Padding="12,4" Margin="6,0,0,0" Click="EditRules_Click"
                                    ToolTip="{loc:Loc Tip_EditRules}" />
                            <ComboBox x:Name="PresetBox" SelectedIndex="2">
                                <ComboBoxItem Content="{loc:Loc Preset_Low}" />
                                <ComboBoxItem Content="{loc:Loc Preset_Medium}" />
                                <ComboBoxItem Content="{loc:Loc Preset_High}" />
                            </ComboBox>
                        </DockPanel>
<WrapPanel Margin="0,6,0,0">
                            <CheckBox x:Name="CandlesCheck" Content="{loc:Loc Opt_Candles}" Margin="0,2,18,2"
                                      ToolTip="{loc:Loc Tip_Candles}" />
                            <CheckBox x:Name="FxGlowCheck" Content="{loc:Loc Opt_FxGlow}" Margin="0,2,0,2"
                                      ToolTip="{loc:Loc Tip_FxGlow}" />
                        </WrapPanel>
<TextBlock Text="{loc:Loc Rules_CustomFile}" Style="{StaticResource FieldLabel}" />
<DockPanel>
                            <CheckBox x:Name="CustomRulesCheck" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"
                                      ToolTip="{loc:Loc Tip_CustomRulesCheck}" />
                            <Button x:Name="BrowseCustomRulesButton" DockPanel.Dock="Right" Content="…" Width="32" Padding="0,4" Margin="6,0,0,0" Click="BrowseCustomRules_Click" />
                            <TextBox x:Name="CustomRulesBox" IsEnabled="{Binding IsChecked, ElementName=CustomRulesCheck}"
                                     ToolTip="{loc:Loc Tip_CustomRulesBox}" />
                        </DockPanel>
                        </StackPanel>
                        <StackPanel x:Name="CatObjects" Visibility="Collapsed">
                            <TextBlock Text="{loc:Loc CatObjects_Desc}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4" />
